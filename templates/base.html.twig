<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <style>
            body {
                background: url("https://placehold.co/100x100/FFFFFF/EFEFEF/png?text=51616");
            }
        </style>

        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/css/bootstrap.min.css" rel="stylesheet">
        {% endblock %}

        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/css/bootstrap.min.css"></script>
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
    <div class="d-flex justify-content-between align-items-center p-3 mb-4 border-bottom">
        <a class="fs-4 text-dark text-decoration-none fw-bold" href="#">Pogodynka</a>
        <nav>
            <a class="btn btn-outline-primary me-2" href="{{ path('app_measurment_index') }}">Measurement</a>
            <a class="btn btn-outline-primary me-2" href="{{ path('app_location_index') }}">Location</a>
{#            <a class="btn btn-outline-secondary" href="{{ path('app_weather_city') }}">Weather</a>#}
        </nav>
    </div>
        {% block body %}{% endblock %}
    </body>
</html>
